{
  "name": "@happier-dev/peer-mediation",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./localServices/preview/httpAdapter": { "types": "./dist/localServices/preview/httpAdapter.d.ts", "default": "./dist/localServices/preview/httpAdapter.js" },
    "./localServices/preview/websocketAdapter": { "types": "./dist/localServices/preview/websocketAdapter.d.ts", "default": "./dist/localServices/preview/websocketAdapter.js" },
    "./localServices/preview/headers": { "types": "./dist/localServices/preview/headers.d.ts", "default": "./dist/localServices/preview/headers.js" },
    "./localServices/preview/rewrites": { "types": "./dist/localServices/preview/rewrites.d.ts", "default": "./dist/localServices/preview/rewrites.js" },
    "./localServices/preview/requestTarget": { "types": "./dist/localServices/preview/requestTarget.d.ts", "default": "./dist/localServices/preview/requestTarget.js" },
    "./localServices/preview/upstreamSocket": { "types": "./dist/localServices/preview/upstreamSocket.d.ts", "default": "./dist/localServices/preview/upstreamSocket.js" },
    "./localServices/preview/limits": { "types": "./dist/localServices/preview/limits.d.ts", "default": "./dist/localServices/preview/limits.js" },
    "./localServices/preview/downstream": { "types": "./dist/localServices/preview/downstream.d.ts", "default": "./dist/localServices/preview/downstream.js" },
    "./localServices/preview/upgradeClient": { "types": "./dist/localServices/preview/upgradeClient.d.ts", "default": "./dist/localServices/preview/upgradeClient.js" },
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "tsc": "node ../../scripts/workspaces/runTypeScriptCli.mjs",
    "build": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "postinstall:real": "yarn -s build",
    "postinstall": "node -e \"const fs=require('fs');const cp=require('child_process');if(/(^|[\\\\/])node_modules([\\\\/]|$)/i.test(process.cwd()))process.exit(0);try{const gate=require('../../scripts/postinstall/shouldRunPostinstall.cjs');if(!gate.shouldRunPostinstall({workspace:'peer-mediation',scope:process.env.HAPPIER_INSTALL_SCOPE||''}))process.exit(0);}catch{}if(!fs.existsSync('tsconfig.json'))process.exit(0);const run=(cmd,args)=>cp.spawnSync(cmd,args,{stdio:'inherit'});const npmExec=process.env.npm_execpath;let r;if(npmExec){r=run(process.execPath,[npmExec,'run','-s','postinstall:real']);}else{r=run(process.platform==='win32'?'yarn.cmd':'yarn',['-s','postinstall:real']);if(r.error&&process.platform==='win32'){r=run('yarn',['-s','postinstall:real']);}}if(r.error){console.error(r.error.message);process.exit(1);}process.exit(r.status??1);\"",
    "test": "../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "yarn -s build && node --test test/*.test.mjs && vitest run --config ../../vitest.config.ts --dir src",
    "typecheck": "../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../scripts/workspaces/runTypeScriptCli.mjs --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@happier-dev/protocol": "0.0.0"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
