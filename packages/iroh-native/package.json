{
  "name": "@happier-dev/iroh-native",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "react-native": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/nodeNative.d.ts",
      "import": "./dist/nodeNative.js",
      "default": "./dist/nodeNative.js"
    }
  },
  "files": ["dist", "native", "ios/HappierIrohNativeModule.swift", "ios/HappierIrohNative.podspec", "android/build.gradle", "android/src", "rust/Cargo.toml", "rust/Cargo.lock", "rust/happier-iroh-core", "rust/happier-iroh-native", "rust/happier-iroh-node", "scripts", "expo-module.config.json", "package.json", "README.md"],
  "scripts": {
    "build": "node ../../scripts/workspaces/buildTypeScriptPackageDist.mjs -p tsconfig.json",
    "build:native": "node scripts/build-node-addon.mjs",
    "build:native:test-relay": "node scripts/build-node-addon.mjs --test-relay-fixture",
    "test:home-iroh:real": "../../apps/stack/bin/hstack-exec --script=test:home-iroh:real:local",
    "test:home-iroh:real:local": "node scripts/run-home-iroh-real-integration.mjs",
    "verify:native": "node scripts/verify-node-addon-load.mjs",
    "verify:iroh-lock-parity": "node scripts/verify-iroh-lock-parity.mjs",
    "verify:native:bun": "bun scripts/verify-node-addon-load.mjs",
    "test": "../../apps/stack/bin/hstack-exec --script=test:local",
    "test:local": "node ../../node_modules/vitest/vitest.mjs run --config ../../vitest.config.ts src && node --test scripts/run-home-iroh-real-integration.test.mjs",
    "typecheck": "../../apps/stack/bin/hstack-exec --script=typecheck:local",
    "typecheck:local": "node ../../scripts/workspaces/runTypeScriptCli.mjs -p tsconfig.json --noEmit"
  },
  "dependencies": { "@happier-dev/protocol": "0.0.0" },
  "devDependencies": { "typescript": "^5.9.2", "vitest": "^3.2.4", "expo-modules-core": "55.0.20" },
  "peerDependencies": { "expo": "*" },
  "peerDependenciesMeta": { "expo": { "optional": true } }
}
